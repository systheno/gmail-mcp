# Gmail MCP Gateway — environment variables
#
# ---------------------------------------------------------------------------
# READ THIS FIRST: for a normal local install you need NONE of these.
#
# By default the gateway generates its own encryption key, reads the OAuth
# client from a file, and puts everything under ~/.config and ~/.local/share.
# These variables exist for containers, systemd units, and secret managers —
# places where a file on disk is the wrong mechanism.
#
# The gateway does NOT read this file automatically. That is deliberate: a
# security tool should not silently absorb secrets from whatever directory it
# happens to be started in. Load it explicitly when you want it:
#
#     set -a && source .env && set +a
#     gmail-mcp-gateway serve --transport stdio
#
# Or point systemd at it with EnvironmentFile=, or Docker with env_file:.
# Copy to `.env` (which .gitignore already excludes) and edit.
# ---------------------------------------------------------------------------


# --- Google OAuth client ----------------------------------------------------
# Alternative to secrets/oauth_client.json. Create a "Desktop app" OAuth client
# in the Google Cloud console with the Gmail API enabled. Not a per-account
# credential — one client serves every account you add.
#
# GMAIL_MCP_OAUTH_CLIENT_ID=1234567890-abcdefg.apps.googleusercontent.com
# GMAIL_MCP_OAUTH_CLIENT_SECRET=GOCSPX-your-client-secret


# --- Credential encryption key ----------------------------------------------
# 32 random bytes, base64. Generate with:
#
#     openssl rand -base64 32
#
# Leave this unset and the gateway creates secrets/master.key (mode 0600) on
# first run — that is the right choice for a normal install. Set it when the key
# must come from a secret manager rather than the filesystem.
#
# WARNING: this key decrypts your stored refresh tokens. Changing it after you
# have added accounts makes their credentials unreadable and every account will
# need `accounts reauth`. Back it up wherever you back up the data directory.
#
# GMAIL_MCP_MASTER_KEY=Replace+With+Output+Of+openssl+rand+base64+32=


# --- Directory layout -------------------------------------------------------
# Defaults shown. Config holds nothing secret; secrets holds everything that
# does. Split them across different mounts if that suits your deployment.
#
# GMAIL_MCP_CONFIG_DIR=~/.config/gmail-mcp-gateway
# GMAIL_MCP_DATA_DIR=~/.local/share/gmail-mcp-gateway
# GMAIL_MCP_SECRETS_DIR=~/.local/share/gmail-mcp-gateway/secrets


# --- HTTP transport ---------------------------------------------------------
# Only consulted with `serve --transport http`. Ignored under stdio.
#
# GMAIL_MCP_HTTP_ENABLED=true
# GMAIL_MCP_HTTP_HOST=127.0.0.1
# GMAIL_MCP_HTTP_PORT=8765
#
# Binding a non-loopback address is refused unless this is true, and an
# internet-routable address is refused even then. Inside a container, 0.0.0.0 is
# container-local, so this is the normal setting there — publish the port to
# 127.0.0.1 on the host.
#
# GMAIL_MCP_ALLOW_REMOTE_BIND=false


# --- Logging ----------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL. Logs go to stderr and pass through
# a redaction filter, so tokens cannot appear in them even at DEBUG.
#
# GMAIL_MCP_LOG_LEVEL=INFO


# ---------------------------------------------------------------------------
# NOT an environment variable: the gateway bearer token that MCP clients send.
# It is created by the CLI, stored as a SHA-256 hash, and belongs in the
# *client's* config, not here:
#
#     gmail-mcp-gateway token create my-agent
# ---------------------------------------------------------------------------
